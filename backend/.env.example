# ==========================================
# IGNITEDDREAMS — ENVIRONMENT CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development

# POSTGRESQL DATABASE URL (Production Target)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/igniteddreams?schema=public"

# AUTHENTICATION
JWT_SECRET="igniteddreams-production-grade-super-secret-key-aviation-2026"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="ignited_session"

# FRONTEND URL (For strict CORS & Cookie Domain)
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# LIVEKIT CLOUD CONFIGURATION
LIVEKIT_URL="https://livekit.example.com"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# CLOUDFLARE R2 PRIVATE VIDEO STORAGE
# Note: Keep the bucket private! Never expose these credentials to frontend.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="igniteddreams-recordings"
R2_ENDPOINT=""

# CENTRALIZED ACADEMY POLICIES
ACADEMY_NAME="IgnitedDreams Aviation Academy"
ACADEMY_TIMEZONE="Asia/Kolkata"
# CRITICAL: 7-Day Automatic Recording Retention Policy
RECORDING_RETENTION_DAYS=7
CLASS_JOIN_WINDOW_MINUTES=15

# INTERNAL CRON / CLEANUP SECRET
CLEANUP_SECRET="ignited-cleanup-cron-secret-key"
